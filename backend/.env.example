# Copy to .env and fill in. No secret belongs in the repository.
# The LOCAL/HOSTED distinction is entirely these two provider names.

# --- HOSTED mode (Render, the judges' live link) ---
LLM_PROVIDER=groq
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- LOCAL mode (offline demo) ---
# LLM_PROVIDER=ollama
# STT_PROVIDER=local
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b
# LOCAL_WHISPER_MODEL=small

# --- Voice call mode ---
# The smallest fast model: voice turns are latency-bound and replies are short.
GROQ_VOICE_MODEL=llama-3.1-8b-instant
VOICE_LLM_MAX_TOKENS=160
VOICE_LLM_TIMEOUT_S=6.0
VOICE_MAX_SENTENCES=2

# Speech synthesis (edge-tts, Microsoft neural voices, no key required).
TTS_ENABLED=true
TTS_TIMEOUT_S=5.0
TTS_DISCOVERY_TIMEOUT_S=8.0
TTS_CACHE_DIR=/tmp/tts-cache
TTS_CACHE_MAX_BYTES=209715200
TTS_PREWARM_ENABLED=true
TTS_PREWARM_CONCURRENCY=8
RATE_LIMIT_TTS=120/minute

# --- Behaviour ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LLM_TIMEOUT_S=8.0
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_DEFAULT=60/minute
CACHE_SIZE=500
CACHE_TTL_S=900

# --- Detection thresholds ---
RISK_SUSPICIOUS_THRESHOLD=35
RISK_SCAM_THRESHOLD=65
CLASSIFIER_WEIGHT=0.5
CLASSIFIER_MIN_PROB=0.85
